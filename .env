# Settings shared by every Vite mode: the dev server, production builds and tests.
# Mode files override these: `.env.development` for the dev server, `.env.production`
# for builds. For personal overrides, use `.env.local` (not committed).

# V1.1 screens (goals, events, analytics, search). Off for releases until Phase 15;
# `.env.development` turns them on for the dev server.
VITE_FEATURE_V1_1=false
